                <mxCell id="redis" value="&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Managed Service for Redis (HA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;кэш: сессии · каталог продуктов&lt;br&gt;результаты поиска · разгрузка БД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2875E2;fontColor=#11203a;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
