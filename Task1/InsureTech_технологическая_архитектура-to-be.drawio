                <mxCell id="obj" value="&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Object Storage (S3-совместимое)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;бэкапы БД + WAL-архив (PITR, RPO ≤ 15 мин) · origin статики для CDN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2875E2;fontColor=#11203a;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
