                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ph1" value="&lt;b&gt;Паттерны: osago-aggregator → страховые (REST)&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1a1a1a;align=center;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="700" width="320" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="pi1" value="TimeOut&lt;br&gt;(≤60c)" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=quota;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="728" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="pi2" value="Retry" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=deploy;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="728" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="pi3" value="Rate&lt;br&gt;Limiter" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=job;" parent="1" vertex="1">
                    <mxGeometry x="1550" y="728" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="pi4" value="Circuit&lt;br&gt;Breaker" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=c_role;" parent="1" vertex="1">
                    <mxGeometry x="1630" y="728" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="ph2" value="&lt;b&gt;web → core-app (ingress)&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1a1a1a;align=center;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="200" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="pi5" value="Rate&lt;br&gt;Limiter" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=job;" parent="1" vertex="1">
                    <mxGeometry x="70" y="328" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="pi6" value="TimeOut" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;fontSize=10;fontStyle=1;prIcon=quota;" parent="1" vertex="1">
                    <mxGeometry x="150" y="328" width="46" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="legY" value="&lt;b style=&quot;font-size:13px&quot;&gt;Обозначения связей&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6C4FB6&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; фиолетовые — события Kafka (асинхронно).&lt;br&gt;&lt;font color=&quot;#828282&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; серые — REST/HTTP/TCP (синхронно).&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; зелёная — SSE.&lt;br&gt;Иконки — паттерны отказоустойчивости (TimeOut, Retry, Rate Limiter, Circuit Breaker).&lt;br&gt;База — Event-Driven (Задание 3): каталог продуктов и оформленные страховки доставляются событиями (Transactional Outbox в core-app + CDC-relay)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF6D5;strokeColor=#D6B656;fontColor=#3a3000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1090" width="620" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="legG" value="&lt;b style=&quot;font-size:13px&quot;&gt;ОСАГО онлайн (Задание 4)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Новый сервис osago-aggregator&lt;/b&gt; — выделен из ins-product-aggregator; рассылает заявки ОСАГО во все страховые (REST: создать + опрос) и отдаёт результаты в core-app. Синхронный «расчёт ОСАГО real-time» (core-app → ins-product-aggregator) удалён.&lt;br&gt;&lt;b&gt;Своё хранилище osago-aggregator-db&lt;/b&gt; — состояние опроса requestId→applicationId, предложения, дедлайны.&lt;br&gt;&lt;b&gt;Интеграция core-app ↔ osago-aggregator — Kafka&lt;/b&gt;: osago-requests (команда «оценить авто»), osago-offers (по событию на каждое предложение → показываем сразу). Асинхронно — без блокировки на 60 c, буфер на пиковую нагрузку.&lt;br&gt;&lt;b&gt;API core-app для веб&lt;/b&gt;: REST POST /osago/quotes + &lt;b&gt;SSE&lt;/b&gt; /stream (зелёная стрелка) — поток предложений по мере ответа страховых; альтернатива WebSocket.&lt;br&gt;&lt;b&gt;Паттерны&lt;/b&gt;: osago-aggregator → страховые — TimeOut ≤60c, Retry, Circuit Breaker (на каждую страховую), Rate Limiter; web → core-app — Rate Limiter + TimeOut; core-app ↔ osago-aggregator (Kafka) — не нужны.&lt;br&gt;&lt;b&gt;Несколько экземпляров&lt;/b&gt;: состояние опроса в общей БД; Rate Limiter к страховым — РАСПРЕДЕЛЁННЫЙ (общий счётчик); SSE — событие должно дойти до инстанса с активным соединением (sticky по requestId / per-instance consumer-group); Circuit Breaker — на инстанс." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E7F4EA;strokeColor=#3C8C4E;fontColor=#143a1d;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=2;" parent="1" vertex="1">
                    <mxGeometry x="1340" y="1090" width="900" height="310" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>